# The Odds API — https://the-odds-api.com (Pinnacle via regions=eu; retail via us,us2)
ODDS_API_KEY=your_odds_api_key_here

# Action Network — optional session cookie from an authenticated browser
# for money % / handle splits (ticket % is often public without auth)
ACTION_NETWORK_COOKIE=

# Pipeline thresholds
EV_THRESHOLD=0.02
MONEY_TICKET_GAP=0.20
MONTE_CARLO_SIMS=10000

# Runtime
DATABASE_URL=sqlite:///./data/sharp_scout.db
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000