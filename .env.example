# The Odds API — https://the-odds-api.com (Pinnacle via regions=eu; retail via us,us2)
# Same key covers NFL (americanfootball_nfl) and NCAAF (americanfootball_ncaaf).
# Also add the same value as a GitHub Actions **repository secret** named ODDS_API_KEY:
# https://github.com/<user>/sharp-scout/settings/secrets/actions
# (A local .env file does NOT apply to GitHub Actions.)
ODDS_API_KEY=your_odds_api_key_here

# Action Network Pro/EDGE — preferred: Bearer JWT from a logged-in session
# (DevTools → Network → scoreboard/publicbetting → Authorization header).
# Long-lived (~1yr). Takes precedence over the cookie.
# Verify with: python scripts/diagnose_action_network.py
# Also add as GitHub Actions secret ACTION_NETWORK_TOKEN.
ACTION_NETWORK_TOKEN=

# Fallback: paste full Cookie header from a logged-in browser
# (DevTools → Network → scoreboard request → Request Headers → Cookie).
# Also add as GitHub Actions secret ACTION_NETWORK_COOKIE.
ACTION_NETWORK_COOKIE=

# Optional comma-separated inactive players for prop reallocation
# INACTIVE_PLAYERS=Stefon Diggs,Cooper Kupp

# Pipeline thresholds
EV_THRESHOLD=0.02
PROP_EV_THRESHOLD=0.02
MONEY_TICKET_GAP=0.20
MONTE_CARLO_SIMS=10000

# Pregame windows (hours before kickoff) and tolerance
PREGAME_WINDOWS_HOURS=12,3,1
PREGAME_WINDOW_TOLERANCE_MINUTES=25

# Runtime
DATABASE_URL=sqlite:///./data/sharp_scout.db
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Google Analytics 4 — weekly unique visitors on GitHub Pages (also add as GitHub Actions secret GA_MEASUREMENT_ID)
GA_MEASUREMENT_ID=G-XXXXXXXXXX
